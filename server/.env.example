PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/booking-system
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/booking-system

# JWT — use long random strings in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URL (CORS + cookies)
CLIENT_URL=http://localhost:5173
# CLIENT_URL=https://your-app.vercel.app
# Email (optional — logs to console if unset)
# RESEND_API_KEY=
# EMAIL_FROM=Bookora <onboarding@resend.dev>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
